<?xml version="1.0" encoding="utf-8"?>
<!-- Juli-o · Hoy: cuánto podés gastar, lo próximo de la agenda y accesos -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_fondo" android:padding="14dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
    <TextView android:id="@+id/w_lbl" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:text="HOY PODÉS GASTAR" android:textSize="10.5sp" android:textStyle="bold" android:letterSpacing="0.08"
        android:textColor="#FF8D93A0" android:maxLines="1"/>
    <TextView android:id="@+id/w_brand" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="● Juli-o" android:textSize="11sp" android:textStyle="bold" android:textColor="#FFC8F06B"/>
  </LinearLayout>
  <TextView android:id="@+id/w_monto" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="—" android:textSize="30sp" android:textStyle="bold" android:fontFamily="monospace"
      android:textColor="#FFC8F06B" android:maxLines="1"/>
  <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Abrí Juli-o una vez para empezar" android:textSize="12sp" android:textColor="#FF8D93A0" android:maxLines="1"
      android:ellipsize="end"/>
  <TextView android:id="@+id/w_agenda" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:layout_marginTop="6dp" android:text="" android:textSize="13sp" android:textColor="#FFF4F5F7"
      android:maxLines="1" android:ellipsize="end"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="38dp" android:layout_marginTop="8dp"
      android:orientation="horizontal">
    <TextView android:id="@+id/w_b_gasto" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginEnd="6dp" android:gravity="center" android:text="＋ Gasto" android:textSize="13sp" android:textStyle="bold"
        android:textColor="#FF0B0C0E" android:background="@drawable/w_btn_main"
        android:maxLines="1"/>
    <TextView android:id="@+id/w_b_agenda" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginEnd="6dp" android:gravity="center" android:text="Agenda" android:textSize="13sp" android:textStyle="bold"
        android:textColor="#FFF4F5F7" android:background="@drawable/w_btn"
        android:maxLines="1"/>
    <TextView android:id="@+id/w_b_cocina" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginEnd="6dp" android:gravity="center" android:text="Cocina" android:textSize="13sp" android:textStyle="bold"
        android:textColor="#FFF4F5F7" android:background="@drawable/w_btn"
        android:maxLines="1"/>
    <TextView android:id="@+id/w_b_pagos" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:gravity="center" android:text="Pagos" android:textSize="13sp" android:textStyle="bold"
        android:textColor="#FFF4F5F7" android:background="@drawable/w_btn" android:maxLines="1"/>
  </LinearLayout>
</LinearLayout>
